{
  "name": "focused",
  "private": true,
  "version": "0.1.0",
  "description": "Focused — a local-first photography workstation: Library, Develop and Composite.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "bench": "playwright test -c bench/playwright.config.ts",
    "trailer:capture": "playwright test -c trailer/playwright.config.ts capture",
    "trailer:render": "playwright test -c trailer/playwright.config.ts render"
  },
  "dependencies": {
    "@fontsource/anton": "5.3.0",
    "@fontsource/bebas-neue": "5.3.0",
    "@fontsource/bungee-shade": "5.3.0",
    "@fontsource/caveat": "5.3.0",
    "@fontsource/dm-serif-display": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/lobster": "5.3.0",
    "@fontsource/monoton": "5.3.0",
    "@fontsource/montserrat": "5.3.0",
    "@fontsource/nabla": "5.3.0",
    "@fontsource/oswald": "5.3.0",
    "@fontsource/pacifico": "5.3.0",
    "@fontsource/permanent-marker": "5.3.0",
    "@fontsource/playfair-display": "5.3.0",
    "@fontsource/press-start-2p": "5.3.0",
    "@fontsource/righteous": "5.3.0",
    "@fontsource/space-mono": "5.3.0",
    "@fontsource/vt323": "5.3.0",
    "@huggingface/transformers": "4.3.0",
    "@tanstack/react-virtual": "3.14.13",
    "exifr": "7.1.3",
    "fflate": "0.8.3",
    "gifenc": "1.0.3",
    "idb": "8.0.3",
    "libraw-wasm": "1.6.0",
    "mp4-muxer": "5.2.2",
    "mp4box": "2.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "utif2": "4.1.0",
    "webm-muxer": "5.1.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "fake-indexeddb": "6.2.5",
